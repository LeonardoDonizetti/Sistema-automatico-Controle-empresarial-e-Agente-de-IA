generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  admin
  atendente
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  cargo     Cargo
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conversas Conversa[]

  @@map("usuarios")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String   @unique
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conversas Conversa[]

  @@map("clientes")
}

model Conversa {
  id          Int       @id @default(autoincrement())
  clienteId   Int       @map("cliente_id")
  atendenteId Int?      @map("atendente_id")
  setor       String?
  status      String    @default("aguardando")
  criadoEm    DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  atendente Usuario? @relation(fields: [atendenteId], references: [id])
  mensagens Mensagem[]

  @@index([clienteId])
  @@index([atendenteId])
  @@index([status])
  @@map("conversas")
}

model Mensagem {
  id         Int      @id @default(autoincrement())
  conversaId Int      @map("conversa_id")
  remetente  String
  conteudo   String
  status     String   @default("recebida")
  criadoEm   DateTime @default(now()) @map("criado_em")

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@index([criadoEm])
  @@map("mensagens")
}