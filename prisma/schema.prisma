generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  admin
  atendente
}

enum StatusAtendimento {
  aguardando
  em_atendimento
  resolvido
  fechado
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  cargo        Cargo
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conversas      Conversa[]
  historicoAcoes HistoricoAtendimento[]

  @@map("usuarios")
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  telefone     String   @unique
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conversas Conversa[]

  @@map("clientes")
}

model Conversa {
  id           Int               @id @default(autoincrement())
  clienteId    Int               @map("cliente_id")
  atendenteId  Int?              @map("atendente_id")
  setor        String?
  status       StatusAtendimento @default(aguardando)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  cliente   Cliente                @relation(fields: [clienteId], references: [id])
  atendente Usuario?               @relation(fields: [atendenteId], references: [id])
  mensagens Mensagem[]
  historico HistoricoAtendimento[]

  @@index([clienteId])
  @@index([atendenteId])
  @@index([status])
  @@map("conversas")
}

model Mensagem {
  id         Int      @id @default(autoincrement())
  conversaId Int      @map("conversa_id")
  remetente  String
  conteudo   String
  status     String   @default("recebida")
  criadoEm   DateTime @default(now()) @map("criado_em")

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@index([criadoEm])
  @@map("mensagens")
}

model HistoricoAtendimento {
  id            Int      @id @default(autoincrement())
  atendimentoId Int      @map("atendimento_id")
  usuarioId     Int?     @map("usuario_id")
  tipo          String
  descricao     String
  criadoEm      DateTime @default(now()) @map("criado_em")

  atendimento Conversa @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([atendimentoId])
  @@index([criadoEm])
  @@map("historico_atendimentos")
}
